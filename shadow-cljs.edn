{:nrepl {:port 8777}

 :source-paths ["src"]

 :dependencies
 [[reagent "2.0.0"]
  [binaryage/devtools "1.0.7"]]

 :builds
 {;; CommonJS build (Node `require`, legacy bundlers).
  :library
  {:target :npm-module
   :output-dir "dist/cjs"
   :entries [jon-nested-menu.react
             jon-nested-menu.nested-menu
             jon-nested-menu.js-mui]
   :exports {:NestedMenu jon-nested-menu.react/NestedMenu
             :ContextMenu jon-nested-menu.react/ContextMenu
             :NestedMenuItem jon-nested-menu.react/NestedMenuItem
             :IconMenuItem jon-nested-menu.react/IconMenuItem
             :ChevronRight jon-nested-menu.react/ChevronRight
             :ChevronDown jon-nested-menu.react/ChevronDown}}

  ;; ESM build (Vite/webpack/esbuild) — enables `import { NestedMenu } ...`.
  :library-esm
  {:target :esm
   :output-dir "dist/esm"
   :modules {:jon-nested-menu
             {:exports {NestedMenu jon-nested-menu.react/NestedMenu
                        ContextMenu jon-nested-menu.react/ContextMenu
                        NestedMenuItem jon-nested-menu.react/NestedMenuItem
                        IconMenuItem jon-nested-menu.react/IconMenuItem
                        ChevronRight jon-nested-menu.react/ChevronRight
                        ChevronDown jon-nested-menu.react/ChevronDown}}}}}}
