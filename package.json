{
	"name": "reagent-mui-nested-menu",
	"version": "0.0.1",
	"description": "Nested MUI menu components for Reagent/ClojureScript and React. Dropdown, context menu, icons, keyboard navigation. Compatible with MUI v5 through v9.",
	"keywords": [
		"mui",
		"material-ui",
		"nested-menu",
		"dropdown",
		"context-menu",
		"reagent",
		"clojurescript",
		"react",
		"menu"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jramosg/jon-nested-menu.git"
	},
	"homepage": "https://github.com/jramosg/jon-nested-menu",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"main": "dist/cjs/reagent_mui_nested_menu.react.js",
	"module": "dist/esm/reagent-mui-nested-menu.js",
	"exports": {
		".": {
			"import": "./dist/esm/reagent-mui-nested-menu.js",
			"require": "./dist/cjs/reagent_mui_nested_menu.react.js"
		},
		"./*": "./dist/*"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"ancient": "clojure -Sdeps '{:deps {com.github.liquidz/antq {:mvn/version \"RELEASE\"}}}' -m antq.core",
		"watch": "npx shadow-cljs watch library library-esm",
		"release": "npx shadow-cljs release library library-esm",
		"release:library": "npx shadow-cljs release library library-esm",
		"demo:cljs": "cd demo && npm run start",
		"demo:react": "npm run release:library && cd demo-react && npm i && npm run dev",
		"build:npm": "npm run release:library",
		"test": "npx shadow-cljs compile test && node target/node-tests.js",
		"prepare": "npm run build:npm",
		"build-report": "npx shadow-cljs run shadow.cljs.build-report library target/build-report.html"
	},
	"dependencies": {},
	"peerDependencies": {
		"@emotion/react": ">=11",
		"@emotion/styled": ">=11",
		"@mui/material": ">=5 <10",
		"react": ">=17 <20",
		"react-dom": ">=17 <20"
	},
	"peerDependenciesMeta": {
		"@emotion/react": {
			"optional": true
		},
		"@emotion/styled": {
			"optional": true
		}
	},
	"devDependencies": {
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"shadow-cljs": "2.26.2"
	}
}