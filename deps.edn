{:paths ["src"]

 :deps {reagent/reagent {:mvn/version "2.0.0"}}

 :aliases
 {:dev {:extra-paths ["dev"]
        :extra-deps {binaryage/devtools {:mvn/version "1.0.7"}}}

  :build {:deps {io.github.abogoyavlensky/slim {:mvn/version "0.3.2"}
                 slipset/deps-deploy {:mvn/version "0.2.2"}}
          :ns-default slim.lib
          :exec-args {:version "0.0.1"
                      :lib io.github.jramosg/reagent-mui-nested-menu
                      ;; Library ships sources only; resources/ holds demo and
                      ;; landing-page assets that must stay out of the jar.
                      :resource-dirs []
                      :url "https://github.com/jramosg/jon-nested-menu"
                      :description "Nested MUI menu components for Reagent: dropdown, context menu, icons and keyboard navigation. Compatible with MUI v5 through v9."
                      :developer "Jon Ramos"}}}}